<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Required by NetworkConnectivityManager to query the active network transport type
        via ConnectivityManager.getActiveNetwork() / getNetworkCapabilities().
        This is a normal (install-time) permission — no user dialog is shown.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
