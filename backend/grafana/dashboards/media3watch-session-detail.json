      "title": "Session vs Fleet (Last 7 Days)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH this_session AS (\n  SELECT\n    startup_time_ms,\n    rebuffer_count,\n    rebuffer_time_ms,\n    rebuffer_ratio,\n    total_dropped_frames,\n    total_seek_count,\n    total_seek_time_ms,\n    mean_video_format_bitrate,\n    error_count\n  FROM sessions\n  WHERE session_id = '$sessionId'\n),\nfleet AS (\n  SELECT\n    ROUND(AVG(startup_time_ms)) AS avg_startup,\n    ROUND(AVG(rebuffer_count::numeric), 2) AS avg_rebuffer_count,\n    ROUND(AVG(rebuffer_time_ms)) AS avg_rebuffer_time,\n    ROUND(AVG(rebuffer_ratio::numeric), 4) AS avg_rebuffer_ratio,\n    ROUND(AVG(total_dropped_frames::numeric), 1) AS avg_dropped_frames,\n    ROUND(AVG(total_seek_count::numeric), 2) AS avg_seek_count,\n    ROUND(AVG(total_seek_time_ms)) AS avg_seek_time,\n    ROUND(AVG(mean_video_format_bitrate)) AS avg_bitrate,\n    ROUND(AVG(error_count::numeric), 2) AS avg_error_count\n  FROM sessions\n  WHERE to_timestamp(timestamp / 1000.0) > NOW() - INTERVAL '7 days'\n)\nSELECT\n  'Startup Time' AS \"Metric\", 'ms' AS \"Unit\",\n  COALESCE(t.startup_time_ms::text, 'N/A') AS \"This Session\",\n  COALESCE(f.avg_startup::text, 'N/A') AS \"Fleet Avg\"\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Rebuffer Count', '',\n  COALESCE(t.rebuffer_count::text, 'N/A'),\n  COALESCE(f.avg_rebuffer_count::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Rebuffer Time', 'ms',\n  COALESCE(t.rebuffer_time_ms::text, 'N/A'),\n  COALESCE(f.avg_rebuffer_time::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Rebuffer Ratio', '%',\n  COALESCE(ROUND(t.rebuffer_ratio::numeric * 100, 2)::text, 'N/A'),\n  COALESCE(ROUND(f.avg_rebuffer_ratio * 100, 2)::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Dropped Frames', '',\n  COALESCE(t.total_dropped_frames::text, 'N/A'),\n  COALESCE(f.avg_dropped_frames::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Seek Count', '',\n  COALESCE(t.total_seek_count::text, 'N/A'),\n  COALESCE(f.avg_seek_count::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Seek Time', 'ms',\n  COALESCE(t.total_seek_time_ms::text, 'N/A'),\n  COALESCE(f.avg_seek_time::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Avg Bitrate', 'bps',\n  COALESCE(t.mean_video_format_bitrate::text, 'N/A'),\n  COALESCE(f.avg_bitrate::text, 'N/A')\nFROM this_session t, fleet f\nUNION ALL\nSELECT 'Error Count', '',\n  COALESCE(t.error_count::text, 'N/A'),\n  COALESCE(f.avg_error_count::text, 'N/A')\nFROM this_session t, fleet f",
          "refId": "A"
        }
      ]
    },
